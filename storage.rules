rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public Mosque Assets (Logos, Photos, PDFs)
    match /mosques/{mosqueId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Azan Audio Files
    match /audio/{allAudio=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default Fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
