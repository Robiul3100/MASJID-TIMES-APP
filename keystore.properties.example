# ===================================================================
# MosqueTime App - Release Signing Keystore Configuration Example
# Copy this file to keystore.properties and fill with your release keys.
# NEVER commit keystore.properties or keystore.jks to public GitHub!
# ===================================================================

KEYSTORE_PATH=keystore.jks
KEYSTORE_PASSWORD=your_secure_keystore_password
KEY_ALIAS=mosquetime_release_key
KEY_PASSWORD=your_secure_key_password
